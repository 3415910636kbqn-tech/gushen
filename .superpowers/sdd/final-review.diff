+
+        headers = ["年度", "每股股息 (USD)"]
+        rows = [[str(int(r["year"])), f"{r['dividend']:.4f}"] for _, r in annual.iterrows()]
+        table = format_table(headers, rows, alignments=["l", "r"])
+        lines.append(table)
+        lines.append("\n*数据来源: yfinance*")

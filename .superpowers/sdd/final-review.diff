+            lines.append("")
+        if medium:
+            lines.append("**中风险:**")
+            for w in medium:
+                lines.append(f"- [{w['type']}] {w['message']}")
+            lines.append("")
+        if low:
+            lines.append("**低风险:**")
+            for w in low:
+                lines.append(f"- [{w['type']}] {w['message']}")
+            lines.append("")
+
+        lines.append(f"*共 {len(self.warnings)} 条自动警示*")
+        return "\n".join(lines)

+    # strategy_w = 持仓股平均5日动量*0.5 + psq_w*0.5
+    avg5 = sum(m["momentum_5d"] for m in r["momentum_top5"]) / len(r["momentum_top5"])
+    expect = round(avg5 * 0.5 + p["psq_w"] * 0.5, 1)
+    assert p["strategy_w"] == expect

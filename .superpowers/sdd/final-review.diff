+                date_str = str(date_val)[:10] if date_val is not None else "—"
+                ih_rows.append([name, shares_str, pct_str, date_str])
+            lines.append(format_table(ih_headers, ih_rows, alignments=["l", "r", "r", "l"]))
+            lines.append("")
